# 配置样例：复制为仓库根目录的 env 文件后填写
# 只有密钥类必填，其余留空即用默认值

APP_NAME=知险有据
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# 分析模型：任意 OpenAI 兼容端点（必填，否则管线全量走规则兜底）
LLM_MODEL=qwen3-vl-plus
LLM_API_KEY=
LLM_BASE_URL=

# Embedding：置 offline 时用本地哈希向量，不联网
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=

# Rerank：不配置时按 RRF 融合分排序
RERANKER_MODEL=qwen3-rerank
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANKER_API_KEY=

# Embedding / Rerank 密钥留空时回落到这个变量
DASHSCOPE_API_KEY=

# 模型不支持工具调用时置 0，风险域分析回退到 JSON 循环
TOOL_CALLING=1

# 检索规模
RERANK_TOP_N=8
EVIDENCE_TOP_N=8

# 材料裁剪上限
MATERIAL_TEXT_LIMIT=60000
MATERIAL_SLICE_LIMIT=5000

# 存储路径，默认在 backend/ 下
# CHROMA_DIR=backend/.chroma
# DATA_DIR=backend/.data
# UPLOAD_DIR=
# DATABASE_URL=sqlite:///绝对路径/app.db
